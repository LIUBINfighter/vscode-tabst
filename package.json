{
  "name": "vscode-tabst",
  "displayName": "vscode-tabst",
  "description": "Open and play Guitar Pro and MusicXML files in VS Code",
  "version": "0.0.5",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LIUBINfighter/vscode-tabst.git"
  },
  "homepage": "https://github.com/LIUBINfighter/vscode-tabst",
  "bugs": {
    "url": "https://github.com/LIUBINfighter/vscode-tabst/issues"
  },
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCustomEditor:vscode-tabst.scoreViewer"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vscode-tabst.openInScoreViewer",
        "title": "Open in Tabst Score Viewer"
      }
    ],
    "customEditors": [
      {
        "viewType": "vscode-tabst.scoreViewer",
        "displayName": "Tabst Score Viewer",
        "selector": [
          {
            "filenamePattern": "*.gp"
          },
          {
            "filenamePattern": "*.gp3"
          },
          {
            "filenamePattern": "*.gp4"
          },
          {
            "filenamePattern": "*.gp5"
          },
          {
            "filenamePattern": "*.gpx"
          },
          {
            "filenamePattern": "*.gp7"
          },
          {
            "filenamePattern": "*.gp8"
          },
          {
            "filenamePattern": "*.musicxml"
          },
          {
            "filenamePattern": "*.mxl"
          }
        ],
        "priority": "default"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "vscode-tabst.openInScoreViewer"
        }
      ],
      "explorer/context": [
        {
          "command": "vscode-tabst.openInScoreViewer",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "vscode-tabst.openInScoreViewer",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('out', { recursive: true, force: true })\"",
    "vscode:prepublish": "npm run compile",
    "compile": "npm run clean && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "package": "npx @vscode/vsce package",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.110.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "@coderline/alphatab": "^1.8.1"
  }
}
